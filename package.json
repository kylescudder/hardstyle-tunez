{
  "name": "hardstyle-tunez",
  "version": "0.1.0",
  "private": true,
  "description": "A private, multi-server Discord music bot backed by Lavalink.",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "register": "node --env-file-if-exists=.env dist/register-commands.js",
    "register:dev": "node --env-file-if-exists=.env --experimental-strip-types src/register-commands.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "shoukaku": "4.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
