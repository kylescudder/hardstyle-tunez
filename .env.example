# Create these values in the Discord Developer Portal.
DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_CLIENT_ID=replace-with-your-application-id

# Set while developing for immediate command updates. Leave empty for global commands.
DISCORD_GUILD_ID=

# Use a long random value. The bot and Lavalink must share it.
LAVALINK_PASSWORD=replace-with-a-long-random-password

# Local-development defaults; Docker Compose overrides the host to `lavalink`.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_SECURE=false
DATA_DIRECTORY=./data
HEALTH_PORT=3000
